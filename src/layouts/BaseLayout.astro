---
import { SITE_TITLE } from '../config';
import "styles/global.css";

interface Props {
  title?: string;
}

const { title = SITE_TITLE } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>