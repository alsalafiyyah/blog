---
import { SITE_TITLE } from '../config';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
  title?: string;
}

const { title = SITE_TITLE } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body itemscope itemtype="https://schema.org/WebPage" class="bg-white dark:bg-zinc-950 dark:text-zinc-100 text-black antialiased selection:bg-black selection:text-white dark:selection:bg-white dark:selection:text-black transition-colors duration-300">
    <Navbar />
    <main role="main" class="max-w-7xl mx-auto px-8">
      <section class="py-24">
       <slot />
      </section>
    </main>
  </body>
</html>