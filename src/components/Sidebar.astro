---
import { getCollection } from 'astro:content';

// Fetch recent posts to display in the sidebar
const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const recentPosts = allPosts.slice(0, 3); // Get top 3 recent posts
---

<aside itemscope itemtype="https://schema.org/WPSideBar" class="hidden md:block md:col-span-3 space-y-12 sticky top-12 self-start">
  <!-- About Widget -->
  <div class="bg-white p-5 rounded-lg border border-gray-200 shadow-sm">
    <h3 class="font-bold text-gray-900 mb-2">About This Blog</h3>
    <p class="text-sm text-gray-600">
      Dedicated to sharing clear and authentic knowledge based on the Quran and Sunnah.
    </p>
  </div>

  <!-- Recent Posts Widget -->
 <div class="border-t-2 border-black dark:border-white pt-4">
    <h3 class="font-bold text-gray-900 mb-3">Recent Posts</h3>
    <ul class="space-y-3 text-sm">
      {recentPosts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="text-blue-600 hover:underline font-medium block">
            {post.data.title}
          </a>
          <span class="text-xs text-gray-400">{post.data.date.toISOString().split('T')[0]}</span>
        </li>
      ))}
    </ul>
  </div>
</aside>