---
interface Props {
  date: string;
  hijri?: string;
  scholar?: string;
  source?: string;
}

const { date, hijri, scholar, source } = Astro.props;
---

<footer class="mt-10 border-t-4 footer-post border-black dark:border-white pt-10 space-y-12 transition-colors">
  <!-- Scholar & Source Box -->
{(scholar || source) && (
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 border-b border-gray-100 dark:border-zinc-800 pb-12 transition-colors">
      <div class="space-y-1">
        {scholar && <p><span class="text-lg font-black italic serif hover:line-through">Scholar:</span> {scholar}</p>}
      </div>
      <div class="space-y-1">
        {source && <p><span class="font-semibold text-gray-900">Source:</span> {source}</p>}
      </div>
    </div>
  )}

  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <!-- Published metadata -->
    <div>
      <p>Published on <span class="font-medium text-gray-900">{date}</span></p>
      {hijri && <p class="text-xs text-gray-500 mt-0.5">Hijri: {hijri}</p>}
    </div>

    <!-- Back to archive link -->
    <a 
      href="/blog/" 
      class="inline-flex items-center gap-1 font-medium text-blue-600 hover:underline"
    >
      &larr; Back to all posts
    </a>
  </div>
</footer>