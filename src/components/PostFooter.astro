---
import { SCHOLAR_GROUPS } from '../config';

interface MuftiItem {
  name: string;
  url: string;
}

interface Props {
  date: string;
  hijri?: string;
  scholar?: string;
  source?: string;
  group?: string;
  mp3?: string;
  muftis?: {
    shaykh?: MuftiItem[];
  };
}

const { date, hijri, scholar, source, group, muftis } = Astro.props;
const activeGroup = group && SCHOLAR_GROUPS[group] ? SCHOLAR_GROUPS[group] : null;
---

<footer class="mt-10 border-t-4 border-black dark:border-white pt-10 space-y-12 transition-colors">
<div class="grid grid-cols-1 md:grid-cols-3 gap-8 border-b border-gray-100 dark:border-zinc-800 pb-12 transition-colors">
  
  {scholar && (
    <div class="hidden grid grid-cols-1 md:grid-cols-3 gap-8 border-b border-gray-100 dark:border-zinc-800 pb-12 transition-colors">
      <div class="space-y-1 text-lg font-black italic font-serif">
        {scholar}
      </div>
    </div>
  )}

{/* Individual Mufti/Shaykh */}
  {muftis?.shaykh && muftis.shaykh.length > 0 && (
    <div class="md:col-span-3 space-y-4">
      <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400">Scholar</h5>
      <div class="flex flex-wrap gap-x-8 gap-y-2">
        {muftis.shaykh.map((item) => (
          <a href={item.url} class="text-lg font-black italic font-serif hover:line-through">
            {item.name}
          </a>
        ))}
      </div>
    </div>
  )}

{/* Group Muftis/Shaykhs */}
{activeGroup && (
    <div class="bg-gray-50 border border-gray-200 p-6 rounded-lg space-y-4 text-xs font-bold uppercase tracking-wider">
      <h4 class="text-gray-900 border-b pb-2">Committee Structure ({group})</h4>
      
      {activeGroup.chairman && activeGroup.chairman.length > 0 && (
        <div>
          <span class="text-gray-400 block mb-1">Chairman:</span>
          {activeGroup.chairman.map((c: any) => (
            <a href={c.url} class="text-blue-600 hover:underline block">{c.name}</a>
          ))}
        </div>
      )}

      {activeGroup.deputy_chairman && activeGroup.deputy_chairman.length > 0 && (
        <div>
          <span class="text-gray-400 block mb-1">Deputy Chairman:</span>
          {activeGroup.deputy_chairman.map((d: any) => (
            <a href={d.url} class="text-blue-600 hover:underline block">{d.name}</a>
          ))}
        </div>
      )}

      {activeGroup.members && activeGroup.members.length > 0 && (
        <div>
          <span class="text-gray-400 block mb-1">Members:</span>
          <div class="space-y-1">
            {activeGroup.members.map((m: any) => (
              <a href={m.url} class="text-blue-600 hover:underline block">{m.name}</a>
            ))}
          </div>
        </div>
      )}
    </div>
  )}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-[10px] font-black uppercase tracking-widest">
    <div class="space-y-6">
      
      <div>
        <span class="text-gray-400 block mb-1">Published:</span>
        <p class="leading-relaxed">
          {hijri ? `${hijri} | ` : ''}{date}
        </p>
      </div>

      {source && (
        <div>
          <span class="text-gray-400 block mb-1">Source:</span>
          <p class="leading-relaxed">
            {source}
          </p>
        </div>
      )}

    </div>
  </div>

</footer>