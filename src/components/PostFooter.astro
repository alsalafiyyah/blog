---
import { SCHOLAR_GROUPS } from '../config';

interface MuftiItem {
  name: string;
  url: string;
}

interface Props {
  date: string;
  hijri?: string;
  scholar?: string;
  source?: string;
  group?: string;
  mp3?: string;
  title?: string;
  muftis?: {
    shaykh?: MuftiItem[];
  };
}

const { date, hijri, scholar, source, group, muftis, title } = Astro.props;
const activeGroup = group && SCHOLAR_GROUPS[group] ? SCHOLAR_GROUPS[group] : null;
const currentUrl = Astro.url.href;
const encodedTitle = encodeURIComponent(title || 'Check out this post');
const encodedUrl = encodeURIComponent(currentUrl);
---

<footer class="mt-10 border-t-4 border-black dark:border-white pt-10 space-y-12 transition-colors">
<div class="grid grid-cols-1 md:grid-cols-3 gap-8 border-b border-gray-100 dark:border-zinc-800 pb-12 transition-colors">
  
  {scholar && (
    <div class="hidden grid grid-cols-1 md:grid-cols-3 gap-8 border-b border-gray-100 dark:border-zinc-800 pb-12 transition-colors">
      <div class="space-y-1 text-lg font-black italic font-serif">
        {scholar}
      </div>
    </div>
  )}

{/* Individual Mufti/Shaykh */}
  {muftis?.shaykh && muftis.shaykh.length > 0 && (
    <div class="md:col-span-3 space-y-4">
      <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400">Scholar</h5>
      <div class="flex flex-wrap gap-x-8 gap-y-2">
        {muftis.shaykh.map((item) => (
          <a href={item.url} class="text-lg font-black italic font-serif hover:line-through">
            {item.name}
          </a>
        ))}
      </div>
    </div>
  )}

{/* Group Muftis/Shaykhs */}
    {activeGroup && (
      <div class="md:col-span-3 space-y-6">
        <h4 class="text-[10px] font-black uppercase tracking-widest text-gray-400 border-b border-gray-100 dark:border-zinc-800 pb-2">
          Scholars of the Permanent Committee for Scholarly Research and Ifta ({group})
        </h4>
        
        {/* Grid wrapper for the committee roles */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          {activeGroup.chairman && activeGroup.chairman.length > 0 && (
            <div class="space-y-2">
              <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400">Chairman</h5>
              <div class="flex flex-col gap-2">
                {activeGroup.chairman.map((c: any) => (
                  <a href={c.url} class="text-lg font-black italic font-serif hover:line-through">{c.name}</a>
                ))}
              </div>
            </div>
          )}

          {activeGroup.deputy_chairman && activeGroup.deputy_chairman.length > 0 && (
            <div class="space-y-2">
              <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400">Deputy Chairman</h5>
              <div class="flex flex-col gap-2">
                {activeGroup.deputy_chairman.map((d: any) => (
                  <a href={d.url} class="text-lg font-black italic font-serif hover:line-through">{d.name}</a>
                ))}
              </div>
            </div>
          )}

          {activeGroup.members && activeGroup.members.length > 0 && (
            <div class="space-y-2">
              <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400">Members</h5>
              <div class="flex flex-col gap-2">
                {activeGroup.members.map((m: any) => (
                  <a href={m.url} class="text-lg font-black italic font-serif hover:line-through">{m.name}</a>
                ))}
              </div>
            </div>
          )}

        </div>
      </div>
    )}

  </div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-[10px] font-black uppercase tracking-widest">
  <div class="space-y-6">
    <div>
      <span class="text-gray-400 block mb-1">Published:</span>
      <p class="leading-relaxed">
        {hijri ? `${hijri} | ` : ''}{date}
      </p>
    </div>
    {source && (
      <div>
        <span class="text-gray-400 block mb-1">Source:</span>
        <p class="leading-relaxed">
          {source}
        </p>
      </div>
    )}
  </div>

  <div class="space-y-6 md:text-right">
    <div>
     <span class="text-gray-400 block mb-4">Spread:</span>
     <div class="flex flex-wrap md:justify-end gap-x-6 gap-y-2">
      <a href={`https://x.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" class="hover:underline text-gray-900 dark:text-white">
        X / Twitter
      </a>
      <a href={`https://www.threads.net/intent/post?text=${encodedTitle}%20${encodedUrl}`} target="_blank" rel="noopener noreferrer" class="hover:underline text-gray-900 dark:text-white">
        Threads
      </a>
      <a href={`https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`} target="_blank" rel="noopener noreferrer" class="hover:underline text-gray-900 dark:text-white">
        Telegram
      </a>
      <a href={`https://wa.me/?text=${encodedTitle}%20${encodedUrl}`} target="_blank" rel="noopener noreferrer" class="hover:underline text-gray-900 dark:text-white">
        WhatsApp
      </a>
      <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="noopener noreferrer" class="hover:underline text-gray-900 dark:text-white">
        Facebook
      </a>
      <a href={`https://vk.com/share.php?url=${encodedUrl}&title=${encodedTitle}`} target="_blank" rel="noopener noreferrer" class="hover:underline text-gray-900 dark:text-white">
        VK
      </a>
     </div>
    </div>
  </div>
</div>

</footer>