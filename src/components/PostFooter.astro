---
interface Props {
  date: string;
  hijri?: string;
  scholar?: string;
  source?: string;
}

const { date, hijri, scholar, source } = Astro.props;
---

<footer class="mt-12 pt-6 border-t border-gray-200 text-sm text-gray-600 space-y-4">
  <!-- Scholar & Source Box -->
  {(scholar || source) && (
    <div class="bg-gray-50 p-4 rounded-lg border border-gray-200 space-y-1">
      {scholar && <p><span class="font-semibold text-gray-900">Scholar:</span> {scholar}</p>}
      {source && <p><span class="font-semibold text-gray-900">Source:</span> {source}</p>}
    </div>
  )}

  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <!-- Published metadata -->
    <div>
      <p>Published on <span class="font-medium text-gray-900">{date}</span></p>
      {hijri && <p class="text-xs text-gray-500 mt-0.5">Hijri: {hijri}</p>}
    </div>

    <!-- Back to archive link -->
    <a 
      href="/blog/" 
      class="inline-flex items-center gap-1 font-medium text-blue-600 hover:underline"
    >
      &larr; Back to all posts
    </a>
  </div>
</footer>