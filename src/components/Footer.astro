---
import { SITE_TITLE } from '../config';
const currentYear = new Date().getFullYear();
---

<footer itemscope itemtype="https://schema.org/WPFooter" class="border-t-4 border-black bg-white text-black dark:border-white dark:bg-zinc-950 dark:text-white py-12 px-8 max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-12 text-[10px] font-black uppercase tracking-[0.2em] transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center text-sm text-gray-500">
    <p>&copy; {currentYear} {SITE_TITLE}. All rights reserved.</p>
    <div class="flex space-x-6 mt-4 md:mt-0">
      <a href="/blog/" class="hover:text-blue-600">Home</a>
      <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600">GitHub</a>
    </div>
  </div>
</footer>