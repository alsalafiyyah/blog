---
import { SITE_TITLE, SITE_URL, FOOTER_MENU } from '../config';
import Logo from '../assets/logo.svg';
import TranslateIcon from '../assets/translate.svg';

const currentYear = new Date().getFullYear();
---

<footer itemscope itemtype="https://schema.org/WPFooter" class="border-t-4 border-black bg-white text-black dark:border-white dark:bg-zinc-950 dark:text-white py-12 px-8 max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-12 text-[10px] font-black uppercase tracking-[0.2em] transition-colors duration-300">
    
    <div itemscope itemtype="https://schema.org/Organization" class="flex flex-col gap-4 max-w-sm w-full">
        <div class="flex items-center justify-between md:justify-start gap-4">

            <a href={SITE_URL} class="flex-none hover:opacity-50 transition-opacity">
                <Logo class="w-auto h-15 object-contain dark:invert transition-all duration-300" />
            </a>

            <button id="theme-toggle" type="button" class="text-black dark:text-white hover:opacity-50 transition-opacity focus:outline-none border-2 border-current p-1.5 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black" aria-label="Toggle Theme">
                <svg id="theme-toggle-dark-icon" class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                </svg>
                <svg id="theme-toggle-light-icon" class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"></path>
                </svg>
            </button>

            <a href="/ar/" class="text-black dark:text-white hover:opacity-50 transition-opacity">
             <TranslateIcon class="w-auto h-15 object-contain dark:invert transition-all duration-300" />
            </a>
        </div>

        <div class="flex flex-col mt-2">
            <p>
                &copy; {currentYear}
                <span itemprop="name">{SITE_TITLE}</span>
                <meta itemprop="url" content={SITE_URL}>
                <link itemprop="logo" href="">
            </p>
            <span class="text-zinc-600 text-[8px] tracking-[0.4em] mt-1">The Manhaj of the Salaf</span>
        </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-12 md:gap-16 w-full md:w-auto">
        <div class="flex flex-col gap-3 min-w-[140px]">
            <span class="text-gray-400 dark:text-zinc-600 text-[9px] tracking-[0.3em]">Navigation</span>
            <div class="flex flex-col gap-2 items-start">
                {FOOTER_MENU.map((item) => (
                    <a itemprop="url" href={item.href} class="hover:line-through transition-all">
                        <span itemprop="name">{item.label}</span>
                    </a>
                ))}
            </div>
        </div>
    </div>
</footer>