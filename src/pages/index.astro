---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allFatwas = (await getCollection('fatwas')).sort(
  (a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featuredFatwa = allFatwas.find((f: any) => f.data.featured) || allFatwas[0];
const recentFatwas = allFatwas.filter((f: any) => f.id !== featuredFatwa?.id).slice(0, 5);

const getCleanUrl = (id: string) => {
  const cleanId = id.includes('/') ? id.split('/').pop() : id;
  return `/fatwas/${cleanId}/`;
};
---

<BaseLayout title="Home - Authentic Islamic Knowledge">
  <div class="space-y-12">

    {/* Featured Fatwa Widget */}
    {featuredFatwa && (

<section class="mb-16 pb-12 border-b-2 border-black/10 dark:border-white/10">
    <div class="flex flex-col space-y-8">
        <div class="flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.3em] text-gray-400 italic">
            <span class="w-2 h-2 rounded-full bg-red-500 flex-shrink-0 mr-2.5"></span>
            <span class="text-black dark:text-white">Selected Fatwa</span>
        </div>
        <h2 class="text-6xl md:text-[5vw] lg:text-[4.5vw] font-black uppercase tracking-tighter leading-[0.85] serif">
            <a href={getCleanUrl(featuredFatwa.id)} class="hover:line-through transition-all">
               {featuredFatwa.data.title}
            </a>
        </h2>
        <div class="flex items-center gap-6 text-[10px] font-black uppercase tracking-widest opacity-50">
            <span>{featuredFatwa.data.hijri} / {featuredFatwa.data.date.toISOString().split('T')[0]}</span>
        </div>
        <p class="text-xl md:text-3xl font-bold leading-relaxed opacity-85 max-w-5xl">
          {featuredFatwa.data.summary}
        </p>
        <div>
            <a href={getCleanUrl(featuredFatwa.id)} class="inline-block bg-black text-white dark:bg-white dark:text-black px-12 py-5 font-black uppercase tracking-widest text-xs hover:scale-105 transition-transform">
                Read Full Fatwa →
            </a>
        </div>

    </div>
</section>
    )}

    {/* Recent Fatwas List */}
    <section class="space-y-6">
      <div class="flex justify-between items-center border-b border-gray-200 dark:border-zinc-800 pb-3">
        <h3 class="text-xl font-bold uppercase tracking-wider">Recent Fatwas</h3>
        <a href="/fatwas/" class="text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline uppercase">
          View All &rarr;
        </a>
      </div>

      <ul class="divide-y divide-gray-100 dark:divide-zinc-800">
        {recentFatwas.map((fatwa: any) => (
          <li class="py-4 space-y-1">
            <a href={getCleanUrl(fatwa.id)} class="text-lg font-semibold text-blue-600 dark:text-blue-400 hover:underline block">
              {fatwa.data.title}
            </a>
            {fatwa.data.scholar && (
              <p class="text-xs text-gray-400 italic font-serif">{fatwa.data.scholar}</p>
            )}
            <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">{fatwa.data.summary}</p>
          </li>
        ))}
      </ul>
    </section>

  </div>
</BaseLayout>