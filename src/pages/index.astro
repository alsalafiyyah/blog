---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/Main.astro';
import imgImam from '../assets/img.webp';
import bgIllustration from '../assets/images/illustration.jfif';

const allFatwas = (await getCollection('fatwas')).sort(
  (a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featuredFatwa = allFatwas.find((f: any) => f.data.featured) || allFatwas[0];
const featuredMuqolat = allFatwas.find((f: any) => f.data.featured_muqolat) || allFatwas[0];
const recentFatwas = allFatwas.filter((f: any) => f.id !== featuredFatwa?.id).slice(0, 5);

const getCleanUrl = (id: string) => {
  const cleanId = id.includes('/') ? id.split('/').pop() : id;
  return `/fatwas/${cleanId}/`;
};
---

<BaseLayout title="Authentic Islamic Knowledge">
  <div class="space-y-12">

    {/* Featured Fatwa Widget */}
    {featuredFatwa && (
      <section class="mb-16 pb-12 border-b-2 border-black/10 dark:border-white/10">
        <div class="flex flex-col space-y-8">
            <div class="flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.3em] text-gray-400 italic">
                <span class="w-2 h-2 rounded-full bg-red-500 flex-shrink-0 mr-2.5"></span>
                <span class="text-black dark:text-white">Selected Fatwa</span>
            </div>
            <h2 class="text-6xl md:text-[5vw] lg:text-[4.5vw] font-black uppercase tracking-tighter leading-[0.85] serif">
                <a href={getCleanUrl(featuredFatwa.id)} class="hover:line-through transition-all">
                   {featuredFatwa.data.title}
                </a>
            </h2>
            <div class="flex items-center gap-6 text-[10px] font-black uppercase tracking-widest opacity-50">
                <span>{featuredFatwa.data.hijri} / {featuredFatwa.data.date.toISOString().split('T')[0]}</span>
            </div>
            <p class="text-xl md:text-3xl font-bold leading-relaxed opacity-85 max-w-5xl">
              {featuredFatwa.data.summary}
            </p>
            <div>
                <a href={getCleanUrl(featuredFatwa.id)} class="inline-block bg-black text-white dark:bg-white dark:text-black px-12 py-5 font-black uppercase tracking-widest text-xs hover:scale-105 transition-transform">
                    Read Full Fatwa →
                </a>
            </div>
        </div>
      </section>
    )}

    <section class="mb-6 pb-12 mt-12">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">

            <div class="col-span-1 flex flex-col space-y-6 lg:col-span-1">
              <div class="border-2 border-black dark:border-white bg-white dark:bg-black overflow-hidden transition-colors duration-300">
                <div class="relative group cursor-pointer w-full bg-gray-50 dark:bg-zinc-900 border-b-2 border-black dark:border-white" id="open-modal-btn">
                  <img src={imgImam.src} alt="Circulated Image of Imam Muhammad bin Abd al-Wahhab" class="w-full h-auto block object-cover">
                   <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs uppercase font-black tracking-widest pointer-events-none">
                       Click to View Full Image
                   </div>
                </div>
                <div class="flex flex-col space-y-4 p-6">
                  <div class="flex items-center gap-6 text-[10px] font-black uppercase tracking-widest opacity-50">
                       <span>1448-03-07 / 20.08.2026</span>
                  </div>
                  <h3 class="text-2xl font-black uppercase tracking-tighter leading-[0.95] serif">
                       The Truth Behind the Circulated Image of Imam Muhammad bin Abd al-Wahhab
                  </h3>
                  <div class="relative">
                        <div id="text-preview" class="space-y-3">
                            <p class="text-sm font-medium leading-relaxed opacity-80">
                                The text in the provided image translates as follows:
                            </p>
                            <p class="text-xs font-normal leading-relaxed opacity-60">
                                <strong>On the right side (False Claim):</strong> An alleged picture of the renewer Imam Muhammad ibn Abd al-Wahhab...
                            </p>
                        </div>
                        <div id="text-full" class="hidden space-y-3 mt-2">
                            <p class="text-sm font-medium leading-relaxed opacity-80">
                                The text in the provided image translates as follows:
                            </p>
                            <p class="text-xs font-normal leading-relaxed opacity-60">
                                <strong>On the right side (False Claim):</strong> An alleged picture of the renewer Imam Muhammad ibn Abd al-Wahhab, may Allah have mercy on him, is being circulated across social media platforms. The image shows a person sitting on a chair, who they claim is Imam Muhammad ibn Saud, may Allah have mercy on him, and another standing beside him, who they claim is Imam Muhammad ibn Abd al-Wahhab, may Allah have mercy on him.
                            </p>
                            <p class="text-xs font-normal leading-relaxed opacity-60">
                                <strong>On the left side (The Truth):</strong> This information is incorrect. The person sitting on the chair is Sheikh Abdullah bin Isa bin Ali Al Khalifa, a son of the ruler of Bahrain, and not Imam Muhammad ibn Saud... It is worth noting that the first photograph was taken in 1826, and the invention of photography was announced on August 19, 1839.
                            </p>
                            <p class="text-xs font-normal leading-relaxed opacity-60">
                                Source: <a href="https://mujaddid.net/%d8%b5%d9%88%d8%b1%d8%a9-%d8%a7%d9%84%d8%a5%d9%85%d8%a7%d9%85-%d8%a7%d9%84%d9%85%d8%ac%d8%af%d8%af-%d9%85%d8%ad%d9%85%d8%af%d8%a8%d9%86-%d8%b9%d8%a8%d8%af%d8%a7%d9%84%d9%88%d9%87%d8%a7%d8%a8-%d8%a7/" target="_blank" class="underline font-bold hover:text-red-500">صورة الإمام محمد بن عبدالوهاب الفوتوغرافية بين الكذب والحقيقة؟!</a>
                            </p>
                        </div>
                  </div>
                    <div class="pt-2">
                        <button id="toggle-text-btn" class="text-xs font-black uppercase tracking-widest text-black dark:text-white border-b-2 border-black dark:border-white pb-1 hover:text-red-500 hover:border-red-500 transition-colors">
                            Show More ↓
                        </button>
                    </div>
                </div>
              </div>
            </div>

            {/* Featured Muqolat Widget */}
            {featuredMuqolat && (
                <div class="col-span-1 flex flex-col space-y-6 lg:col-span-1">
                  <div class="relative bg-cover bg-no-repeat bg-center flex flex-col justify-end min-h-[450px] overflow-hidden" style={`background-image: url(${bgIllustration.src});`}>
                   <span class="text-xs font-sans font-bold text-white absolute left-6 top-6 pb-2.5 border-b-2 border-red-500 z-10">Muqolat</span>
                   <div class="flex flex-col items-start justify-end text-left pt-32 px-8 pb-8 bg-gradient-to-t from-black/90 via-black/40 to-transparent w-full">
                    <h3 class="flex items-center font-sans font-bold text-xs text-white mb-3">
                      <span class="w-2 h-2 rounded-full bg-red-500 flex-shrink-0 mr-2.5"></span>
                       {featuredMuqolat.data.hijri} / {featuredMuqolat.data.date.toISOString().split('T')[0]}
                    </h3>
                    <a href={getCleanUrl(featuredMuqolat.id)} class="text-white text-2xl font-bold hover:underline leading-snug">
                      {featuredMuqolat.data.title}
                    </a>
                   </div>
                  </div>
                </div>
            )}

            {/* Recent Fatwas List - Compacted Vertical Height */}
            <div class="col-span-1 flex flex-col space-y-4 lg:col-span-1">
              <span class="text-[10px] font-black uppercase tracking-widest text-gray-400 block mb-2">Recent Fatwas</span>
              <div class="space-y-4 divide-y divide-gray-100 dark:divide-zinc-800">
               {recentFatwas.map((fatwa: any) => (
                <div class="pt-4 first:pt-0 flex flex-col space-y-1">
                  <span class="text-[9px] font-bold uppercase tracking-widest opacity-40">
                    {fatwa.data.hijri} / {fatwa.data.date.toISOString().split('T')[0]}
                  </span>
                  <a href={getCleanUrl(fatwa.id)} class="text-sm font-black uppercase leading-tight hover:underline">
                    {fatwa.data.title}
                  </a>
                </div>
               ))}
              </div>

              <div class="pt-6 flex flex-col w-full">
                  <div class="w-full flex h-0.5 bg-yellow-700 bg-opacity-10">
                      <div class="w-1/2 bg-red-500 h-full"></div>
                  </div>
                  <a href="/fatwas/" class="font-sans text-xs uppercase font-bold pt-4 flex w-full items-center justify-between hover:text-red-500 transition-colors">
                      <span>View All Fatwas</span>
                      <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 text-red-500">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                  </a>
              </div>
            </div>

        </div>
    </section>

  </div>

<div id="image-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden flex items-center justify-center p-4 md:p-10">
    <button id="close-modal-btn" class="absolute top-6 right-6 text-white bg-black border-2 border-white p-3 hover:bg-red-500 hover:border-red-500 transition-colors z-50">
        <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" fill="none" class="w-6 h-6">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
    </button>
    <div class="relative max-w-5xl max-h-full flex items-center justify-center">
        <img id="modal-img" src={imgImam.src} alt="Full View" class="max-w-full max-h-[85vh] object-contain border-4 border-white">
    </div>
</div>
</BaseLayout>

<script>
document.addEventListener("DOMContentLoaded", () => {
    // --- Image Modal Logic ---
    const openBtn = document.getElementById("open-modal-btn");
    const closeBtn = document.getElementById("close-modal-btn");
    const modal = document.getElementById("image-modal");

    if (openBtn && modal && closeBtn) {
        openBtn.addEventListener("click", () => {
            modal.classList.remove("hidden");
            document.body.style.overflow = "hidden";
        });
        const closeModal = () => {
            modal.classList.add("hidden");
            document.body.style.overflow = "auto";
        };
        closeBtn.addEventListener("click", closeModal);
        modal.addEventListener("click", (e) => {
            if (e.target === modal) closeModal();
        });
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeModal();
        });
    }

    // Show More / Show Less Text Toggle Logic ---
    const toggleBtn = document.getElementById("toggle-text-btn");
    const textPreview = document.getElementById("text-preview");
    const textFull = document.getElementById("text-full");

    if (toggleBtn && textPreview && textFull) {
        toggleBtn.addEventListener("click", () => {
            const isHidden = textFull.classList.contains("hidden");
            if (isHidden) {
                textFull.classList.remove("hidden");
                textPreview.classList.add("hidden");
                toggleBtn.textContent = "Show Less ↑";
            } else {
                textFull.classList.add("hidden");
                textPreview.classList.remove("hidden");
                toggleBtn.textContent = "Show More ↓";
            }
        });
    }
});
</script>