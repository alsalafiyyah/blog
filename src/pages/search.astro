---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SEARCH_PLACEHOLDER_TITLE, SEARCH_TITLE } from '../config';

const allPosts = (await getCollection('fatwas')).sort(
  (a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf()
);

const searchIndex = allPosts.map((post: any) => ({
  id: post.id.includes('/') ? post.id.split('/').pop() : post.id,
  title: post.data.title,
  summary: post.data.summary,
  date: post.data.date.toISOString().split('T')[0],
  category: post.data.category || [],
  scholar: post.data.shaykh || '',
}));
---

<BaseLayout title={`${SEARCH_TITLE}`} description={`Search the database of fatwas on ${SITE_TITLE}.`}>
  <div class="space-y-8">
    <header class="border-b-4 border-black dark:border-white pb-6 space-y-2">
      <span class="text-[10px] font-black uppercase tracking-widest text-gray-400">Database Search</span>
      <h1 class="text-3xl md:text-4xl font-black uppercase tracking-tight serif">{SEARCH_TITLE}</h1>
    </header>

    {/* Search Input Form */}
    <form method="GET" action="/search/" class="flex gap-2">
      <input 
        type="text" 
        name="q" 
        id="search-input"
        placeholder={SEARCH_PLACEHOLDER_TITLE}
        class="flex-grow px-4 py-3 border-2 border-black dark:border-white bg-transparent text-black dark:text-white font-medium text-sm focus:outline-none focus:bg-black focus:text-white dark:focus:bg-white dark:focus:text-black transition-all"
      />
      <button 
        type="submit" 
        class="px-6 py-3 border-2 border-black dark:border-white bg-black text-white dark:bg-white dark:text-black text-xs font-black uppercase tracking-widest hover:opacity-75 transition-opacity"
      >
        {SEARCH_TITLE}
      </button>
    </form>

    {/* Search Results Container */}
    <div id="search-results" class="space-y-6 pt-4">
      <p id="search-status" class="text-xs font-bold uppercase tracking-widest text-gray-400">Enter a keyword above to start searching.</p>
      <ul id="results-list" class="divide-y divide-gray-100 dark:divide-zinc-800"></ul>
    </div>
  </div>

  {/* Pass search index safely using a JSON script tag */}
  <script id="search-index" type="application/json" set:html={JSON.stringify(searchIndex)} />

  <script>
    // Read the search index safely from the JSON script tag
    const indexElement = document.getElementById('search-index');
    const posts = indexElement ? JSON.parse(indexElement.textContent || '[]') : [];

    const urlParams = new URLSearchParams(window.location.search);
    const query = (urlParams.get('q') || '').toLowerCase().trim();

    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const searchStatus = document.getElementById('search-status');
    const resultsList = document.getElementById('results-list');

    if (searchInput) {
      searchInput.value = query;
    }

    if (query && resultsList && searchStatus) {
      const filtered = posts.filter((post: any) => 
        post.title.toLowerCase().includes(query) || 
        post.summary.toLowerCase().includes(query) ||
        post.scholar.toLowerCase().includes(query) ||
        post.category.some((cat: string) => cat.toLowerCase().includes(query))
      );

      if (filtered.length > 0) {
        searchStatus.textContent = `Found ${filtered.length} result(s) for "${query}":`;
        resultsList.innerHTML = filtered.map((post: any) => `
          <li class="py-6 space-y-2">
            <a href="/fatwas/${post.id}/" class="text-xl font-bold text-blue-600 dark:text-blue-400 hover:underline block">
              ${post.title}
            </a>
            ${post.scholar ? `<p class="text-xs text-gray-400 font-serif italic">${post.scholar}</p>` : ''}
            <p class="text-sm text-gray-600 dark:text-gray-300 line-clamp-2">${post.summary}</p>
          </li>
        `).join('');
      } else {
        searchStatus.textContent = `No matching fatwas found for "${query}".`;
      }
    }
  </script>
</BaseLayout>