---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PAGE_VIDEOS_TITLE } from '../../config';

const allFatwas = (await getCollection('fatwas')).sort(
  (a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf()
);

const videoFatwas = allFatwas.filter((post: any) => post.data.videoID || post.data.videoURL);

const getCleanUrl = (id: string) => {
  const cleanId = id.includes('/') ? id.split('/').pop() : id;
  return `/blog/fatwas/${cleanId}/`;
};
---

<BaseLayout title={`${PAGE_VIDEOS_TITLE}`}>
  <div class="space-y-8">
    <header class="border-b-4 border-black dark:border-white pb-6 space-y-2">
      <span class="text-[10px] font-black uppercase tracking-widest text-gray-400">Media Library</span>
      <h1 class="text-3xl md:text-4xl font-black uppercase tracking-tight serif">
        {PAGE_VIDEOS_TITLE}
      </h1>
      <p class="text-xs text-gray-500 font-bold uppercase tracking-wider">
        Found {videoFatwas.length} video recording{videoFatwas.length === 1 ? '' : 's'}
      </p>
    </header>

    {videoFatwas.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {videoFatwas.map((post: any) => (
          <div class="border-2 border-black dark:border-white p-4 space-y-3 bg-zinc-50 dark:bg-zinc-900 rounded flex flex-col justify-between">
            <div class="space-y-3">
              {/* YouTube Thumbnail Preview */}
              {post.data.videoID && (
                <a href={getCleanUrl(post.id)} class="block aspect-video overflow-hidden border border-black dark:border-white relative group">
                  <img 
                    src={`https://img.youtube.com/vi/${post.data.videoID}/hqdefault.jpg`} 
                    alt={post.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                  <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors flex items-center justify-center">
                    <span class="bg-red-600 text-white p-2 rounded-full shadow-lg">
                      <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    </span>
                  </div>
                </a>
              )}

              <div class="flex items-center gap-2">
                <span class="text-[9px] font-black uppercase tracking-widest text-gray-400">
                  {post.data.date.toISOString().split('T')[0]}
                </span>
              </div>
              
              <a href={getCleanUrl(post.id)} class="text-lg font-bold text-blue-600 dark:text-blue-400 hover:underline block leading-snug">
                {post.data.title}
              </a>
              
              {post.data.scholar && (
                <p class="text-xs text-gray-400 font-serif italic">{post.data.scholar}</p>
              )}
              
              <p class="text-xs text-gray-600 dark:text-gray-300 line-clamp-2">{post.data.summary}</p>
            </div>

            <div class="pt-2 border-t border-gray-200 dark:border-zinc-800">
              <a href={getCleanUrl(post.id)} class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 hover:underline">
                Watch & Read Fatwa &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-sm text-gray-500 italic">No {PAGE_VIDEOS_TITLE} found yet.</p>
    )}

    <div class="pt-4">
      <a href="/" class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 hover:underline">
        &larr; Back to Home
      </a>
    </div>
  </div>
</BaseLayout>