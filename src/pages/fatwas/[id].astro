---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostFooter from '../../components/PostFooter.astro';

export async function getStaticPaths() {
  const posts = await getCollection('fatwas');
  return posts.map((post: any) => {
    const id = post.id.includes('/') ? post.id.split('/').pop() : post.id;
    return {
      params: { id },
      props: { post },
    };
  });
}

const { post } = Astro.props as any;
const { Content } = await render(post);
const formattedDate = post.data.date.toISOString().split('T')[0];
const mp3 = post.data.mp3;
const videoID = post.data.videoID;
const videoURL = post.data.videoURL;

const getAudioSrc = (fileOrUrl: string) => {
  if (fileOrUrl.startsWith('http://') || fileOrUrl.startsWith('https://')) {
    return fileOrUrl;
  }
  return `/audio/${fileOrUrl}`;
};
---

<BaseLayout title={post.data.title} 
  description={post.data.summary} 
  publishDate={formattedDate} 
  ogType="article" 
  mp3={mp3} 
  videoID={videoID}
>
<div class="prose prose-xl prose-black">
      <header class="mb-6 border-b-4 border-black dark:border-white">
          <div class="max-w-full">
           <h1 itemprop="headline" class="text-3xl md:text-[3vw] leading-[0.9] font-black uppercase tracking-tighter serif">
              {post.data.title}
           </h1>
          </div>
      </header>
  <div class="post">
    {mp3 && (
      <div class="mb-10 mt-10">
        <media-theme-tailwind-audio style="width:100%">
          <audio slot="media" src={getAudioSrc(mp3)} playsinline></audio>
        </media-theme-tailwind-audio>
      </div>
    )}
{/* Video Widget / Embed */}
    {videoID && (
      <div class="mb-10 mt-10 space-y-2">
        <div class="relative w-full aspect-video border-2 border-black dark:border-white overflow-hidden bg-black">
          <iframe 
            src={`https://www.youtube-nocookie.com/embed/${videoID}`} 
            title={post.data.title}
            class="absolute top-0 left-0 w-full h-full"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
          ></iframe>
        </div>
      </div>
    )}
   <Content />
  </div>
<PostFooter 
  date={formattedDate} 
  hijri={post.data.hijri} 
  scholar={post.data.shaykh} 
  shaykh={frontmatter.shaykh} 
  source={post.data.source} 
  group={post.data.group}
  muftis={post.data.muftis}
  title={post.data.title} 
  category={post.data.category}
/>
</div>
</BaseLayout>