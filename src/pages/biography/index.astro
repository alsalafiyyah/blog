---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PAGE_BIOGRAPHY_TITLE } from '../../config';

const scholars = (await getCollection('biography')).sort(
  (a: any, b: any) => a.data.name.localeCompare(b.data.name)
);

const getCleanUrl = (id: string) => {
  const cleanId = id.includes('/') ? id.split('/').pop() : id;
  return `/biography/${cleanId}/`;
};
---

<BaseLayout title={`${PAGE_BIOGRAPHY_TITLE}`}>
  <div class="space-y-8">
    <header class="border-b-4 border-black dark:border-white pb-6 space-y-2">
      <span class="text-[10px] font-black uppercase tracking-widest text-gray-400">Directory</span>
      <h1 class="text-3xl md:text-4xl font-black uppercase tracking-tight serif">{PAGE_BIOGRAPHY_TITLE}</h1>
    </header>

    <ul class="divide-y divide-gray-100 dark:divide-zinc-800">
      {scholars.map((scholar: any) => (
        <li class="py-6 space-y-2">
          <a href={getCleanUrl(scholar.id)} class="text-xl font-bold text-blue-600 dark:text-blue-400 hover:underline block">
            {scholar.data.name}
          </a>
          {scholar.data.title && (
            <p class="text-xs text-gray-400 font-serif italic">{scholar.data.title}</p>
          )}
          <p class="text-sm text-gray-600 dark:text-gray-300 line-clamp-2">{scholar.data.summary}</p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>