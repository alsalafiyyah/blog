---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const scholars = await getCollection('biography');
  
  // Explicitly type 'scholar' as 'any' to fix error 7006
  return scholars.map((scholar: any) => {
    const id = scholar.id.includes('/') ? scholar.id.split('/').pop() : scholar.id;
    return {
      params: { id },
      props: { scholar },
    };
  });
}

// Cast Astro.props as any to fix 'Property data does not exist on type never' errors
const { scholar } = Astro.props as any;
const { Content } = await render(scholar);
---

<BaseLayout title={scholar.data.name}>
  <div class="space-y-8">
    <header class="border-b-4 border-black dark:border-white pb-6 space-y-2">
      <h1 class="text-3xl md:text-4xl font-black uppercase tracking-tight serif">
        {scholar.data.name}
      </h1>
      {scholar.data.title && (
        <p class="text-xs text-gray-400 font-serif italic">{scholar.data.title}</p>
      )}
      {scholar.data.died && (
        <p class="text-xs font-bold uppercase tracking-wider text-gray-500">Passed away: {scholar.data.died}</p>
      )}
    </header>

    <div class="post prose prose-xl prose-black dark:prose-invert">
      <Content />
    </div>

  </div>
</BaseLayout>