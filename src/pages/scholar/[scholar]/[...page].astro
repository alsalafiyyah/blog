---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import type { Page } from 'astro';
import { SCHOLAR_PER_PAGE } from '../../../config';

export async function getStaticPaths({ paginate }: any) {
  const slugify = (text: string) => {
    return text
      .toString()
      .toLowerCase()
      .trim()
      .replace(/\s+/g, '-')     
      .replace(/[^\w-]+/g, '')  
      .replace(/--+/g, '-');    
  };

  const allFatwas = (await getCollection('fatwas')).sort(
    (a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf()
  );

  const scholarMap = new Map<string, string>(); 

  allFatwas.forEach((post: any) => {
    if (post.data.scholar) {
      const originalName = post.data.scholar.trim();
      const slug = slugify(originalName);
      if (slug) {
        scholarMap.set(slug, originalName);
      }
    }
  });

  return Array.from(scholarMap.entries()).flatMap(([scholarSlug, originalName]) => {
    const filteredPosts = allFatwas.filter((post: any) => {
      if (!post.data.scholar) return false;
      return slugify(post.data.scholar) === scholarSlug;
    });

    return paginate(filteredPosts, {
      params: { scholar: scholarSlug },
      props: { scholarName: originalName },
      pageSize: SCHOLAR_PER_PAGE || 10,
    });
  });
}

const { page } = Astro.props as { page: Page<any>; scholarName: string };
const { scholarName } = Astro.props;
const { scholar } = Astro.params;

const displayName = scholarName || (scholar ? scholar.toUpperCase() : 'Scholar');

const base = import.meta.env.BASE_URL;
const getCleanUrl = (id: string) => {
  const cleanId = id.includes('/') ? id.split('/').pop() : id;
  return `${base.replace(/\/$/, '')}/fatwas/${cleanId}/`;
};
---

<BaseLayout title={`Fatwas by ${displayName} - Page ${page.currentPage}`}>
  <div class="space-y-8">
    <header class="border-b-4 border-black dark:border-white pb-6 space-y-2">
      <span class="text-[10px] font-black uppercase tracking-widest text-gray-400">Scholar Archive</span>
      <h1 class="text-3xl md:text-4xl font-black uppercase tracking-tight serif">
        {displayName}
      </h1>
      <p class="text-xs text-gray-500 font-bold uppercase tracking-wider">
        Showing page {page.currentPage} of {page.lastPage} ({page.total} total fatwas)
      </p>
    </header>

    {page.data.length > 0 ? (
      <ul class="divide-y divide-gray-100 dark:divide-zinc-800">
        {page.data.map((post: any) => (
          <li class="py-6 space-y-2">
            <div class="flex items-center gap-2">
              <span class="text-xs text-gray-400 font-bold">
                {post.data.date.toISOString().split('T')[0]}
              </span>
            </div>
            
            <a href={getCleanUrl(post.id)} class="text-xl font-bold text-dark dark:text-white hover:underline block">
              {post.data.title}
            </a>
            
            <p class="text-sm text-gray-600 dark:text-gray-300 line-clamp-2">{post.data.summary}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-sm text-gray-500 italic">No fatwas found for this scholar.</p>
    )}

    {/* Pagination Controls */}
    <div class="flex items-center justify-between pt-8 border-t border-gray-200 dark:border-zinc-800">
      {page.url.prev ? (
        <a href={page.url.prev} class="text-xs font-black uppercase tracking-wider text-black dark:text-white border-2 border-black dark:border-white px-4 py-2 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors">
          &larr; Newer Posts
        </a>
      ) : <div />}

      {page.url.next ? (
        <a href={page.url.next} class="text-xs font-black uppercase tracking-wider text-black dark:text-white border-2 border-black dark:border-white px-4 py-2 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors">
          Older Posts &rarr;
        </a>
      ) : <div />}
    </div>
  </div>
</BaseLayout>