---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGE_404_TITLE, PAGE_404_HEADER, PAGE_404_TEXT } from '../config';
---

<BaseLayout title={PAGE_404_TITLE}>
  <div class="text-center py-16 space-y-6">
    <h1 class="text-6xl font-black text-gray-900">{PAGE_404_HEADER}</h1>
    <h2 class="text-2xl font-bold text-gray-700">{PAGE_404_TITLE}</h2>
    <p class="text-gray-500 max-w-md mx-auto">
      {PAGE_404_TEXT}
    </p>
  </div>
</BaseLayout>